{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(/main.sh)", "Write(/main.sh)",
      "Edit(/Snakefile)", "Write(/Snakefile)",
      "Edit(/Dockerfile)", "Write(/Dockerfile)",
      "Edit(/.dockerignore)", "Write(/.dockerignore)",
      "Edit(/environment.yml)", "Write(/environment.yml)",
      "Edit(/requirements.txt)", "Write(/requirements.txt)",
      "Edit(/package.json)", "Write(/package.json)",
      "Edit(/package-lock.json)", "Write(/package-lock.json)",
      "Edit(/tsconfig.json)", "Write(/tsconfig.json)",
      "Edit(/CLAUDE.md)", "Write(/CLAUDE.md)",
      "Edit(/.claude/**)", "Write(/.claude/**)",
      "Edit(/scripts/00_reference/**)", "Write(/scripts/00_reference/**)",
      "Edit(/scripts/04_annotate/**)", "Write(/scripts/04_annotate/**)",
      "Edit(/scripts/05_results/**)", "Write(/scripts/05_results/**)",
      "Edit(/scripts/lib/**)", "Write(/scripts/lib/**)",
      "Read(../molde/**)", "Read(../**/molde/**)"
    ]
  }
}
