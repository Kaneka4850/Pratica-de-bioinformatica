dados/04_annotate/**/*
dados/05_results/**/*
dados/06_quality_metrics/**/*
!dados/0[2-6]_*/**/
!dados/0[2-6]_*/**/.gitkeep

# Gerados pelo main.sh / Snakemake
.snakemake/
config/recursos.yaml

# Node, Python e R
node_modules/
__pycache__/
*.pyc
.venv/
.Rhistory
.RData

